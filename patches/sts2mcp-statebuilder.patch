+            // so "draw_pile" and the markdown renderer are byte-for-byte unchanged.
+            var drawOrder = new List<string?>();
+            var drawOrderEnchantments = new List<Dictionary<string, object?>?>();
+            foreach (var card in combatState.DrawPile.Cards)
+            {
+                drawOrder.Add(SafeGetText(() => card.Title));
+                drawOrderEnchantments.Add(BuildEnchantment(card));
+            }
+            state["draw_pile_order"] = drawOrder;

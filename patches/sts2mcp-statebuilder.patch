+    /// <summary>
+    /// A card's enchantment, or null. Cards carry at most one
+    /// (<c>CardModel.Enchantment</c> is a single reference, not a list).
+    ///
+    /// Without this the enchantment is only visible baked into the rendered
+    /// <c>description</c> string: a Nimble 耸肩无视 reads "获得10点格挡" while the
+    /// card definition says 8, and nothing in the JSON says why. Anything that
+    /// simulates from the card id then silently uses the wrong number.
+    ///
+    /// <c>amount</c> is the raw <c>Amount</c>; how it applies depends on the
+    /// enchantment (Nimble is <c>EnchantBlockAdditive</c>, others are
+    /// multiplicative or change play count), so consumers must key off
+    /// <c>id</c> rather than assuming it is additive.
+    /// </summary>
+    private static Dictionary<string, object?>? BuildEnchantment(CardModel card)
+    {
+        var e = card.Enchantment;
+        if (e == null) return null;
+        return new Dictionary<string, object?>
+        {
+            ["id"] = e.Id.Entry,
+            ["name"] = SafeGetText(() => e.Title),
+            ["amount"] = e.Amount,
+        };
+    }
